# Copy to .env and fill in. Every variable here is read by bot/config.py;
# the values shown are the defaults unless marked "required".

# ── Discord ───────────────────────────────────────────────────────────────
# required
BOT_TOKEN=
# comma-separated; parsed but not used yet (commands sync globally)
GUILD_IDS=
# enables owner-only commands (/reload, /send)
OWNER_ID=
# command log and AI error reports go here
LOG_CHANNEL_ID=
# /feedback submissions go here
FEEDBACK_CHANNEL_ID=
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING

# ── AI (/ai) via OpenRouter ───────────────────────────────────────────────
# required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# required: Yuuka's persona prompt
OPENROUTER_SYSTEM_PROMPT=
MAX_HISTORY_LENGTH=50               # messages kept per chat / voice session
READ_MESSAGES_MAX=30                # most messages the read_messages tool reads at once

# ── Web search (the agent's web_search tool) ─────────────────────────────
# empty = web search disabled
TAVILY_API_KEY=
SEARCH_CACHE_TTL_MINUTES=30

# ── Speech-to-text (/transcribe and /ai voice) ───────────────────────────
# free key: https://console.groq.com/keys
GROQ_API_KEY=
STT_BACKEND=auto                    # auto | groq | local
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_S=20

# Local fallback (used when Groq is unset, unreachable or rate-limited)
STT_MODEL=auto                      # auto | tiny | base | small | large-v3-turbo | <ct2 dir>
STT_DEVICE=auto                     # auto | cpu | cuda
STT_COMPUTE_TYPE=auto               # auto | int8 | int8_float16 | float16 | float32
STT_CPU_THREADS=0                   # 0 = let CTranslate2 decide
# e.g. en,th,ja; empty = any language, one = hard lock
STT_LANGUAGE=
STT_BEAM_SIZE=5

# Utterance segmentation
STT_SILENCE_MS=800                  # packet silence that ends an utterance
STT_MIN_SEGMENT_MS=400              # shorter than this is a blip, not speech
STT_MAX_SEGMENT_S=20                # force-flush a monologue
STT_MIN_PEAK=0.02                   # reject segments quieter than this

# ── Wake word (/ai voice only; /transcribe is deliberately ungated) ───────
STT_WAKE_WORDS=ยูกะ,ยูคะ,ยุกะ,ยูกา,yuuka,yuka,yuuca,ゆうか,ゆか
STT_WAKE_THRESHOLD=80               # rapidfuzz partial_ratio 0-100
STT_WAKE_HEAD_CHARS=0               # 0 = name anywhere in the sentence; N = first N chars
STT_WAKE_BRIDGE_WINDOW_S=2.5        # how long a bare-name segment waits for its continuation
STT_ANSWER_WINDOW_S=15              # how long after she asks a question the asker can answer without her name
STT_WAKE_RELAXED_THRESHOLD=70       # text threshold once the acoustic score is confident
STT_WAKE_ACOUSTIC_CONFIDENT_SCORE=0.5

# Acoustic pre-filter: skips transcription of segments that don't sound like her name
STT_WAKE_ACOUSTIC_ENABLED=true
STT_WAKE_ACOUSTIC_MODEL_PATH=models/wake_word/yuuka_wakeword_v2.onnx
STT_WAKE_ACOUSTIC_THRESHOLD=0.02
