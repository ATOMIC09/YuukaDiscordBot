# Copy to .env and fill in. Every variable here is read by bot/config.py;
# the values shown are the defaults unless marked "required".

# ── Discord ───────────────────────────────────────────────────────────────
# required
BOT_TOKEN=
# comma-separated; parsed but not used yet (commands sync globally)
GUILD_IDS=
# enables owner-only commands (/reload, /send)
OWNER_ID=
# command log and AI error reports go here
LOG_CHANNEL_ID=
# /feedback submissions go here
FEEDBACK_CHANNEL_ID=
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING

# ── AI (/ai) via OpenRouter ───────────────────────────────────────────────
# required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=4096          # cap on one reply, reasoning included; OpenRouter checks your credit against it
# required: Yuuka's persona prompt
OPENROUTER_SYSTEM_PROMPT=
MAX_HISTORY_LENGTH=50               # messages kept per chat / voice session
READ_MESSAGES_MAX=30                # most messages the read_messages tool reads at once
AGENT_MAX_ROUNDS=8                  # model calls per turn (each is one OpenRouter request; the last has no tools)
AGENT_MAX_TOOL_CALLS=25             # tool calls one reply may make (e.g. songs queued in one go)

# ── Server memory (/memory setup) ────────────────────────────────────────
# Notes are kept as messages in a hidden channel of each server, not on this machine.
MEMORY_MAX_FACTS=500                # notes per server; saving past it is refused
MEMORY_NOTICE_MAX=20                # most notes added to a request on their own; 0 = only when she searches
MEMORY_NOTICE_MAX_CHARS=5000        # most characters of them, header included; all of it is prompt tokens on the free model
MEMORY_OFFERS=true                  # she may offer, with a button, to remember a lasting fact about the member; false = only when asked

# ── Web search (the agent's web_search tool) ─────────────────────────────
# empty = web search disabled
TAVILY_API_KEY=
SEARCH_CACHE_TTL_MINUTES=30

# ── Speech-to-text (/transcribe and /ai voice) ───────────────────────────
# free key: https://console.groq.com/keys
GROQ_API_KEY=
STT_BACKEND=auto                    # auto | groq | local
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_S=20

# Local fallback (used when Groq is unset, unreachable or rate-limited)
STT_MODEL=auto                      # auto | tiny | base | small | large-v3-turbo | <ct2 dir>
STT_DEVICE=auto                     # auto | cpu | cuda
STT_COMPUTE_TYPE=auto               # auto | int8 | int8_float16 | float16 | float32
STT_CPU_THREADS=0                   # 0 = let CTranslate2 decide
# e.g. en,th,ja; empty = any language, one = hard lock
STT_LANGUAGE=
STT_BEAM_SIZE=5

# Utterance segmentation
STT_SILENCE_MS=800                  # packet silence that ends an utterance
STT_MIN_SEGMENT_MS=400              # shorter than this is a blip, not speech
STT_MAX_SEGMENT_S=20                # force-flush a monologue
STT_MIN_PEAK=0.02                   # reject segments quieter than this

# ── Wake word (/ai voice only; /transcribe is deliberately ungated) ───────
STT_WAKE_WORDS=ยูกะ,ยูคะ,ยุกะ,ยูกา,yuuka,yuka,yuuca,ゆうか,ゆか,8日,八日,よっか,ยุคค่ะ
STT_WAKE_THRESHOLD=80               # rapidfuzz partial_ratio 0-100
STT_WAKE_HEAD_CHARS=0               # 0 = search the whole sentence; N = only within the first N chars
STT_WAKE_ANYWHERE=true              # the name counts anywhere in the sentence; false = only at its start or end
STT_TRIM_BEFORE_NAME=true           # leave earlier talk out of what STT hears when a pause comes before her name
STT_LISTEN_WINDOW_S=5               # after a bare wake word (and the chime), how long she waits for the request to start
STT_ANSWER_WINDOW_S=7               # how long after she asks a question the asker can answer without her name
VOICE_SPOKEN_MAX_CHARS=200          # most of a reply she reads aloud; the whole reply is always posted in the text chat
SPEECH_OVER_MUSIC_GAIN=2           # how loud her voice is over a playing track: 1 = as synthesised, 3 = about +10 dB (loud peaks are softened, not clipped)
# An acoustic score at or above this is her name before STT has read it: the chime sounds at
# once, and a transcript without the name is still taken as a call. Above 1 turns it off.
# 0.9 is for yuuka_wakeword_v2; v3 reaches it on ordinary talk, so do not use it with v3.
STT_WAKE_ACOUSTIC_CONFIDENT_SCORE=0.9
# UNUSED: a looser text threshold for a confident score; the transcript is taken as it is instead.
STT_WAKE_RELAXED_THRESHOLD=70

# Acoustic pre-filter: skips transcription of segments that don't sound like her name
STT_WAKE_ACOUSTIC_ENABLED=true
STT_WAKE_ACOUSTIC_MODEL_PATH=models/wake_word/yuuka_wakeword_v2.onnx
STT_WAKE_ACOUSTIC_THRESHOLD=0.85     # best score over every 80 ms hop; raise it if Groq rate limits (429) show up in a busy call
# Dev only: a second model scored on the same audio and logged next to the first (it never
# decides), e.g. models/wake_word/yuuka_wakeword_v3.onnx. Leave empty in production.
STT_WAKE_ACOUSTIC_COMPARE_PATH=
